# ===========================================
# ACFS Railway — Environment Variables
# Copy to .env and fill in your values
# ===========================================

# --- API Keys (at least one required for AI agents) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- GitHub CLI (enables agents to create PRs, manage issues) ---
GH_TOKEN=

# --- Web Terminal Auth ---
TTYD_USER=admin
TTYD_PASS=changeme

# --- Container Identity ---
ACFS_USER=dev
ACFS_HOSTNAME=acfs

# --- Git ---
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- SSH (for git over SSH) ---
# Paste full key contents, including BEGIN/END lines
SSH_PRIVATE_KEY=
SSH_PUBLIC_KEY=

# --- Dotfiles (cloned on first boot) ---
DOTFILES_REPO=

# --- oh-my-opencode subscriptions ---
OMO_CLAUDE=yes
OMO_OPENAI=no
OMO_GEMINI=no
OMO_COPILOT=no
OMO_OPENCODE_ZEN=no
OMO_ZAI_CODING_PLAN=no
OMO_OPENCODE_GO=no

# --- Cloud CLI Auth (auto-detected by each CLI) ---
RAILWAY_TOKEN=
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
CLOUDFLARE_API_TOKEN=
VAULT_ADDR=
VAULT_TOKEN=

# --- OAuth Authentication (optional, replaces basic auth) ---
# Create a GitHub OAuth App: Settings → Developer settings → OAuth Apps
# Set callback URL to: https://YOUR-APP.railway.app/oauth2/callback
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
# OAUTH2_PROVIDER=github
# OAUTH2_ALLOWED_EMAILS=*
# OAUTH2_GITHUB_ORG=
# OAUTH2_REDIRECT_URL=

# --- Agent Resource Limits ---
# AGENT_MEM_LIMIT=8589934592
# AGENT_NPROC=256
# AGENT_NOFILE=4096

# --- Webhooks (optional) ---
# WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_SECRET=
