#!/bin/bash
# xsel shim — routes clipboard operations through OSC 52
# Some tools expect xsel instead of xclip. Same OSC 52 approach.
#
# Supported flags (subset matching real xsel):
#   --clipboard, -b   (default, ignored — always uses clipboard)
#   --input, -i       (copy stdin — default)
#   --output, -o      (paste from tmux buffer)

direction="in"

while [ $# -gt 0 ]; do
    case "$1" in
        --clipboard|-b) ;; # default, no-op
        --primary|-p)   ;; # treat same as clipboard
        --input|-i)     direction="in" ;;
        --output|-o)    direction="out" ;;
        --append|-a)    direction="in" ;; # append treated as overwrite
        *)              ;; # ignore unknown flags
    esac
    shift
done

if [ "$direction" = "out" ]; then
    tmux save-buffer - 2>/dev/null || true
    exit 0
fi

data=$(base64 | tr -d '\n')
if [ -n "$TMUX" ]; then
    osc52=$(printf '\ePtmux;\e\e]52;c;%s\a\e\\' "$data")
    pane_tty=$(tmux display-message -p '#{pane_tty}' 2>/dev/null)
    if [ -n "$pane_tty" ] && [ -w "$pane_tty" ]; then
        printf '%s' "$osc52" > "$pane_tty"
    else
        printf '%s' "$osc52"
    fi
else
    printf '\e]52;c;%s\a' "$data"
fi
